# ══════════════════════════════════════════════════════════════════════════════
# InsightFlow AI — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ══════════════════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=InsightFlow AI
DEBUG=false
SECRET_KEY=change-me-to-a-random-64-char-string

# ── LLM (Required) ────────────────────────────────────────────────────────────
# Get your Gemini API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro

# ── Web Search (Optional — enables WEB/HYBRID classification) ────────────────
# Get your Tavily key from: https://tavily.com
TAVILY_API_KEY=your-tavily-api-key-here

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default for dev — no setup required)
DATABASE_URL=sqlite+aiosqlite:///./insightflow.db

# PostgreSQL (for production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/insightflow

# ── MongoDB (Required for schema metadata + memory) ───────────────────────────
# Local MongoDB:
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=insightflow

# MongoDB Atlas (production):
# MONGODB_URL=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority

# ── File Storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=100

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]

# ── Elasticsearch / Vector Search (Phase 4 — RAG Knowledge Base) ────────────
# Local (matches docker-compose):
ELASTIC_URL=http://localhost:9200
ELASTIC_API_KEY=

# Elastic Cloud:
# ELASTIC_URL=https://your-deployment.es.us-east-1.aws.found.io
# ELASTIC_API_KEY=your-api-key-here

# Optional: pip install sentence-transformers (for real embeddings)
# Without it, InsightFlow uses a deterministic hash fallback (no semantic search)

# ── Observability (Optional — Phase 17) ──────────────────────────────────────
DYNATRACE_URL=
DYNATRACE_TOKEN=
